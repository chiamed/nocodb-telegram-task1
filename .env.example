# Copy this file to .env and fill in the real values

# Base URL where NocoDB is hosted
nocodb_url=http://localhost:8080

# API auth token from NocoDB
nocodb_auth_token=your-nocodb-token

# Table IDs in NocoDB
table_areas=your-areas-table-id
table_departments=your-departments-table-id
table_users=your-users-table-id

# Path to a JSON file for single imports
nocodb_upload_file_path=./data.json

# Your Telegram bot token
telegram_bot_token=your-telegram-token
